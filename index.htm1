<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر منصور سامي | TSHALZ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
        body { font-family: 'Cairo', sans-serif; background-color: #0b0c10; color: #ffffff; }
        
        /* Gradients & Shadows */
        .gold-gradient { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
        .app-banner { background: linear-gradient(180deg, rgba(217, 119, 6, 0.15) 0%, rgba(15, 15, 22, 0.95) 100%); border: 1px solid rgba(245, 158, 11, 0.4); }
        .card-dark { background-color: #12131a; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; }
        .card-hover:hover { border-color: rgba(245, 158, 11, 0.5); }
        
        /* Badges */
        .badge-rare { background-color: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
        .badge-epic { background-color: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.4); }
        .badge-legendary { background-color: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.5); }
        .badge-normal { background-color: rgba(156, 163, 175, 0.15); color: #9ca3af; border: 1px solid rgba(156, 163, 175, 0.3); }

        /* Wheel Elements */
        .wheel-container { position: relative; width: 300px; height: 300px; margin: 0 auto; }
        .wheel { width: 100%; height: 100%; border-radius: 50%; border: 6px solid #f59e0b; position: relative; overflow: hidden; transition: transform 5s cubic-bezier(0.15, 0.85, 0.15, 1); box-shadow: 0 0 30px rgba(245, 158, 11, 0.3); }
        .wheel-pointer { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 10px solid transparent; border-right: 10px solid transparent; border-top: 20px solid #f59e0b; z-index: 40; }
        .prize-item { position: absolute; width: 70px; height: 50px; left: calc(50% - 35px); top: 12px; transform-origin: 35px 138px; display: flex; flex-direction: column; align-items: center; font-size: 8px; font-weight: 700; color: #fff; text-shadow: 0 1px 2px #000; }

        /* Ticker Animation */
        .announcement-ticker { background: #161722; border-bottom: 1px solid rgba(245, 158, 11, 0.2); color: #fbbf24; padding: 6px 0; font-size: 11px; font-weight: 700; overflow: hidden; white-space: nowrap; }
        .ticker-track { display: inline-block; animation: tickerMove 25s linear infinite; padding-left: 100%; }
        @keyframes tickerMove { 0% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(-100%, 0, 0); } }
    </style>
</head>
<body class="pb-24">

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 bg-amber-500 text-black font-black px-5 py-2 rounded-xl text-xs z-[100] opacity-0 pointer-events-none transition-all shadow-xl">
        تم بنجاح! ✨
    </div>

    <!-- Announcement Ticker -->
    <div class="announcement-ticker">
        <div class="ticker-track">
            ⚡ تنبيه هام: التعامل حصرياً عبر الروابط الرسمية لمتجر منصور سامي | 🏆 مبروك لكل الأبطال الفائزين بجوائز العجلة الأسبوعية
        </div>
    </div>

    <!-- Header -->
    <header class="flex justify-between items-center px-4 py-3 bg-[#12131a] border-b border-gray-800 sticky top-0 z-50">
        <div class="flex items-center gap-2 cursor-pointer" ondblclick="playSound('click'); openAdminLogin()">
            <div class="w-9 h-9 rounded-xl gold-gradient flex items-center justify-center font-black text-black text-lg shadow">م</div>
            <div>
                <h1 class="font-bold text-xs text-amber-400">متجر منصور سامي</h1>
                <span class="text-[9px] text-gray-400">الزوار: <strong id="globalVisitorsCount" class="text-amber-400">0</strong></span>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="playSound('click'); openLoginModal()" id="loginBtnHeader" class="gold-gradient text-black font-bold px-3 py-1.5 rounded-lg text-xs">تسجيل الدخول</button>
        </div>
    </header>

    <main class="p-4 space-y-5 max-w-md mx-auto">

        <!-- Tab 1: Home (الرئيسية) -->
        <div id="tab-home" class="space-y-4">
            
            <!-- App Download Banner -->
            <div class="app-banner p-4 rounded-2xl text-center space-y-3 relative overflow-hidden">
                <div class="flex items-center justify-center gap-2 text-amber-400 font-bold text-sm">
                    <span>🔥 حمّل تطبيق تشالز</span>
                    <span class="bg-amber-500/20 p-1 rounded-lg text-xs">📱</span>
                </div>
                <p class="text-[10px] text-gray-300">أيقونة على شاشتك الرئيسية، فتح أسرع، وتجربة كاملة الشاشة</p>
                <button onclick="showToast('جاري بدء التحميل... 🚀')" class="w-full gold-gradient text-black font-black py-2.5 rounded-xl text-xs shadow-lg flex items-center justify-center gap-1">
                    <span>📥 تنزيل التطبيق الآن</span>
                </button>
                <span class="text-[9px] text-gray-400 block">مجاني • بدون متجر تطبيقات • تثبيت مباشر</span>
            </div>

            <!-- Featured Rewards Grid (جوائز مميزة) -->
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-sm text-white">جوائز مميزة</h3>
                    <button onclick="switchTab('store', document.querySelector('[data-tab=\'store\']'))" class="text-[11px] text-amber-400 font-bold">عرض الكل ›</button>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <!-- Item 1 -->
                    <div class="card-dark p-3 text-center space-y-2 card-hover relative">
                        <div class="w-full h-20 bg-black/40 rounded-xl flex items-center justify-center text-3xl overflow-hidden border border-gray-800">
                            🏷️
                        </div>
                        <h4 class="font-bold text-xs text-white">بطاقة تغيير الاسم</h4>
                        <div class="flex justify-between items-center pt-1">
                            <span class="badge-normal text-[9px] px-2 py-0.5 rounded">عادية</span>
                            <span class="text-amber-400 font-black text-xs">100</span>
                        </div>
                    </div>

                    <!-- Item 2 -->
                    <div class="card-dark p-3 text-center space-y-2 card-hover relative">
                        <div class="w-full h-20 bg-black/40 rounded-xl flex items-center justify-center text-3xl overflow-hidden border border-gray-800">
                            📦
                        </div>
                        <h4 class="font-bold text-xs text-white">قسيمة صندوق</h4>
                        <div class="flex justify-between items-center pt-1">
                            <span class="badge-normal text-[9px] px-2 py-0.5 rounded">عادية</span>
                            <span class="text-amber-400 font-black text-xs">250</span>
                        </div>
                    </div>

                    <!-- Item 3 -->
                    <div class="card-dark p-3 text-center space-y-2 card-hover relative">
                        <div class="w-full h-20 bg-black/40 rounded-xl flex items-center justify-center text-3xl overflow-hidden border border-gray-800">
                            💎
                        </div>
                        <h4 class="font-bold text-xs text-white">60 UC</h4>
                        <div class="flex justify-between items-center pt-1">
                            <span class="badge-normal text-[9px] px-2 py-0.5 rounded">عادية</span>
                            <span class="text-amber-400 font-black text-xs">500</span>
                        </div>
                    </div>

                    <!-- Item 4 -->
                    <div class="card-dark p-3 text-center space-y-2 card-hover relative">
                        <div class="w-full h-20 bg-black/40 rounded-xl flex items-center justify-center text-3xl overflow-hidden border border-gray-800">
                            🧰
                        </div>
                        <h4 class="font-bold text-xs text-white">صندوق كلاسيكي</h4>
                        <div class="flex justify-between items-center pt-1">
                            <span class="badge-normal text-[9px] px-2 py-0.5 rounded">عادية</span>
                            <span class="text-amber-400 font-black text-xs">750</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Spin Wheel Section -->
            <div class="card-dark p-4 text-center space-y-3">
                <h3 class="font-bold text-sm text-amber-400">عجلة الحظ الحصرية 🔥</h3>
                
                <div id="subChannelBox" class="bg-amber-950/20 border border-amber-500/30 p-3 rounded-xl space-y-2">
                    <p class="text-[10px] text-amber-200 font-bold">⚠️ شرط أساسي للتدوير:</p>
                    <a href="https://t.me/BB4BB2" target="_blank" onclick="playSound('click'); markChannelClicked()" class="block bg-black/60 border border-amber-500/40 text-amber-300 p-2 rounded-xl text-xs font-bold">
                        📢 اشترك في القناة الرسمية (@BB4BB2)
                    </a>
                    <button onclick="playSound('click'); verifySubscription()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-1.5 rounded-xl text-xs">
                        ✅ تحقق من الاشتراك
                    </button>
                </div>

                <div class="wheel-container my-3 opacity-40 pointer-events-none" id="wheelWrapper">
                    <div class="wheel-pointer"></div>
                    <div id="wheel" class="wheel"></div>
                    <div class="absolute inset-[33%] rounded-full bg-[#12131a] border-2 border-amber-400 flex items-center justify-center cursor-pointer z-30" onclick="spinWheel()">
                        <span class="text-xs font-black text-amber-400">أدر 🎡</span>
                    </div>
                </div>

                <button onclick="spinWheel()" id="spinBtn" disabled class="w-full bg-gray-800 text-gray-500 font-bold py-2.5 rounded-xl text-xs cursor-not-allowed">اشترك وسجل الدخول للتدوير</button>
                <p id="timerText" class="text-[10px] text-red-400 font-semibold"></p>
            </div>
        </div>

        <!-- Tab 2: Store (متجر الجوائز) -->
        <div id="tab-store" class="space-y-3 hidden">
            <div class="flex justify-between items-center border-b border-gray-800 pb-2">
                <h3 class="font-bold text-sm text-white">قائمة الجوائز والمكافآت</h3>
                <span class="text-xs text-gray-400">رصيدك: <strong id="storePoints" class="text-amber-400">0</strong> نقطة</span>
            </div>
            
            <div id="storeItemsContainer" class="space-y-2"></div>
        </div>

        <!-- Tab 3: Creators (صناع المحتوى / الجوائز الخاصة) -->
        <div id="tab-creators" class="space-y-3 hidden">
            <div class="bg-amber-950/20 border border-amber-500/30 p-3 rounded-xl flex justify-between items-center">
                <div>
                    <h3 class="font-bold text-sm text-amber-400">صناع المحتوى</h3>
                    <p class="text-[9px] text-gray-300">شركاء المتجر - تابعهم لأحدث العروض والجوائز</p>
                </div>
                <div class="bg-black/50 px-3 py-1 rounded-lg border border-amber-500/40 text-amber-400 text-xs font-black">
                    <span id="creatorPoints">450</span> نقطة
                </div>
            </div>

            <!-- Creator Cards List -->
            <div class="space-y-2">
                <!-- Creator 1 -->
                <div class="card-dark p-3 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full border border-amber-400 bg-amber-500/20 flex items-center justify-center font-bold text-amber-300 text-xs">👑</div>
                        <span class="font-bold text-xs text-white">تشالز</span>
                    </div>
                    <div class="flex gap-1">
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">📢</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">🎵</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">📸</a>
                    </div>
                </div>

                <!-- Creator 2 -->
                <div class="card-dark p-3 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full border border-gray-700 bg-gray-800 flex items-center justify-center text-xs">🎧</div>
                        <span class="font-bold text-xs text-white">ABN Z3EM</span>
                    </div>
                    <div class="flex gap-1">
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">📢</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">🎵</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">▶️</a>
                    </div>
                </div>

                <!-- Creator 3 -->
                <div class="card-dark p-3 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full border border-gray-700 bg-gray-800 flex items-center justify-center text-xs">🎧</div>
                        <span class="font-bold text-xs text-white">MoShawaly</span>
                    </div>
                    <div class="flex gap-1">
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">📢</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">🎵</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">▶️</a>
                    </div>
                </div>

                <!-- Creator 4 -->
                <div class="card-dark p-3 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full border border-gray-700 bg-gray-800 flex items-center justify-center text-xs">🎧</div>
                        <span class="font-bold text-xs text-white">بندرو</span>
                    </div>
                    <div class="flex gap-1">
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">📢</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">🎵</a>
                        <a href="#" class="bg-black/60 p-2 rounded-lg border border-gray-800 text-amber-400 text-xs">▶️</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 4: Prizes (جوائزي) -->
        <div id="tab-prizes" class="space-y-3 hidden">
            <div class="card-dark p-4 space-y-3">
                <h3 class="font-bold text-sm text-amber-400 border-b border-gray-800 pb-2">🏆 جوائزي وسجل الطلبات</h3>
                <div id="myPrizesListContainer" class="space-y-2 text-xs">
                    <p class="text-gray-500 text-center py-6">لا توجد جوائز مسجلة بعد</p>
                </div>
            </div>
        </div>

        <!-- Tab 5: Notifications (الإشعارات) -->
        <div id="tab-notifications" class="space-y-3 hidden">
            <div class="card-dark p-4 space-y-3">
                <h3 class="font-bold text-sm text-amber-400 border-b border-gray-800 pb-2">🔔 الإشعارات والمنضمين الجدد</h3>
                <div id="notificationsUsersList" class="space-y-1.5 max-h-36 overflow-y-auto pr-1 text-xs"></div>
                <div id="notificationsContainer" class="space-y-2 text-xs pt-2"></div>
            </div>
        </div>

        <!-- Tab 6: Profile (ملف اللاعب) -->
        <div id="tab-profile" class="space-y-4 hidden">
            <div id="adminQuickAccessBox" class="hidden">
                <button onclick="playSound('click'); openDirectAdminPanel()" class="w-full gold-gradient text-black font-black py-2.5 rounded-xl text-xs shadow-lg border border-amber-300">
                    ⚙️ لوحة تحكم الأدمن الرئيسي
                </button>
            </div>

            <div class="card-dark p-4 space-y-4 text-center">
                <div class="flex flex-col items-center space-y-1">
                    <div class="w-16 h-16 rounded-full border-2 border-amber-400 bg-black/60 flex items-center justify-center text-2xl">
                        🔥
                    </div>
                    <h2 class="font-bold text-sm text-white" id="profileNameDisplay">زائر</h2>
                    <span class="text-[10px] text-gray-400" id="profileSubDisplay">-</span>
                </div>

                <div class="grid grid-cols-3 gap-2 pt-1">
                    <div class="bg-black/50 p-2 rounded-xl text-center border border-gray-800">
                        <span class="text-[9px] text-gray-400 block">النقاط</span>
                        <span class="font-black text-amber-400 text-xs" id="profilePointsVal">0</span>
                    </div>
                    <div class="bg-black/50 p-2 rounded-xl text-center border border-gray-800">
                        <span class="text-[9px] text-gray-400 block">الإحالات</span>
                        <span class="font-black text-purple-400 text-xs" id="profileRefsVal">0</span>
                    </div>
                    <div class="bg-black/50 p-2 rounded-xl text-center border border-gray-800">
                        <span class="text-[9px] text-gray-400 block">الجوائز</span>
                        <span class="font-black text-amber-400 text-xs" id="profilePrizesVal">0</span>
                    </div>
                </div>

                <!-- Referral Section -->
                <div class="space-y-2 text-right pt-2 border-t border-gray-800">
                    <span class="text-xs text-amber-400 font-bold block">🚀 رابط الدعوة الخاص بك</span>
                    <div class="flex gap-1">
                        <input id="profileRefLink" type="text" readonly class="w-full bg-black/80 border border-gray-800 p-2 rounded-xl text-[10px] text-amber-300 text-center outline-none" />
                        <button onclick="playSound('click'); copyReferralLink()" class="gold-gradient text-black font-bold px-3 py-1 rounded-xl text-xs whitespace-nowrap">نسخ 📋</button>
                    </div>
                </div>

                <button onclick="playSound('click'); logoutUser()" class="w-full bg-red-950/60 hover:bg-red-900 text-red-400 font-bold py-2 rounded-xl text-xs border border-red-800/40">تسجيل الخروج</button>
            </div>
        </div>

    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 bg-[#12131a] border-t border-gray-800 flex justify-around py-2.5 text-[10px] z-50">
        <button onclick="playSound('click'); switchTab('home', this)" class="flex flex-col items-center text-amber-400 nav-btn" data-tab="home"><span>🏠</span><span class="mt-0.5">الرئيسية</span></button>
        <button onclick="playSound('click'); switchTab('store', this)" class="flex flex-col items-center text-gray-400 hover:text-amber-400 nav-btn" data-tab="store"><span>🛒</span><span class="mt-0.5">متجر الجوائز</span></button>
        <button onclick="playSound('click'); switchTab('prizes', this)" class="flex flex-col items-center text-gray-400 hover:text-amber-400 nav-btn" data-tab="prizes"><span>🎁</span><span class="mt-0.5">جوائزي</span></button>
        <button onclick="playSound('click'); switchTab('notifications', this)" class="flex flex-col items-center text-gray-400 hover:text-amber-400 nav-btn" data-tab="notifications"><span>🔔</span><span class="mt-0.5">الإشعارات</span></button>
        <button onclick="playSound('click'); switchTab('profile', this)" class="flex flex-col items-center text-gray-400 hover:text-amber-400 nav-btn" data-tab="profile"><span>👤</span><span class="mt-0.5">ملف اللاعب</span></button>
    </nav>

    <!-- Modals -->
    <div id="loginModal" class="fixed inset-0 bg-black/80 hidden z-50 flex items-center justify-center p-4">
        <div class="card-dark w-full max-w-sm rounded-2xl p-5 space-y-4 text-center">
            <h3 class="font-bold text-amber-400 text-sm">تسجيل الدخول في المتجر</h3>
            <input id="userPhoneOrTg" type="text" placeholder="أدخل يوزر تليجرام الخاص بك" class="w-full bg-black/60 border border-gray-800 p-2.5 rounded-xl text-white text-xs text-center outline-none" style="direction: ltr;">
            <button onclick="playSound('click'); loginUser()" class="w-full gold-gradient text-black font-bold py-2.5 rounded-xl text-xs">دخول 🚀</button>
            <button onclick="playSound('click'); closeLoginModal()" class="text-gray-500 text-xs">إلغاء</button>
        </div>
    </div>

    <div id="adminLoginModal" class="fixed inset-0 bg-black/85 hidden z-50 flex items-center justify-center p-4">
        <div class="card-dark w-full max-w-xs rounded-2xl p-5 space-y-3 text-center">
            <h3 class="font-bold text-amber-400 text-sm">🔒 لوحة الأدمن</h3>
            <input id="adminPasswordInput" type="password" placeholder="كلمة المرور" class="w-full bg-black/60 border border-gray-800 p-2 rounded-xl text-white text-center text-xs outline-none">
            <div class="flex gap-2">
                <button onclick="playSound('click'); verifyAdmin()" class="w-1/2 gold-gradient text-black font-bold py-2 rounded-xl text-xs">دخول</button>
                <button onclick="playSound('click'); closeAdminLogin()" class="w-1/2 bg-gray-800 text-white py-2 rounded-xl text-xs">إغلاق</button>
            </div>
        </div>
    </div>

    <!-- Admin Panel Modal -->
    <div id="adminPanelModal" class="fixed inset-0 bg-black/90 hidden z-50 flex items-center justify-center p-4">
        <div class="card-dark w-full max-w-lg rounded-2xl p-4 space-y-4 text-xs max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-gray-800 pb-2">
                <h3 class="font-bold text-amber-400 text-sm">لوحة تحكم الأدمن ⚙️</h3>
                <button onclick="playSound('click'); closeAdminPanel()" class="text-gray-400 font-bold">✕</button>
            </div>
            <div class="bg-black/50 p-3 rounded-xl space-y-2 border border-gray-800">
                <h4 class="font-bold text-amber-400">📥 طلبات الفوز والاستبدال:</h4>
                <div id="adminRequestsList" class="space-y-2 max-h-40 overflow-y-auto"></div>
            </div>
            <button onclick="playSound('click'); closeAdminPanel()" class="w-full gold-gradient text-black font-bold py-2.5 rounded-xl text-xs">إغلاق اللوحة</button>
        </div>
    </div>

    <script>
        // Audio Engine
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            try {
                if (audioCtx.state === 'suspended') { audioCtx.resume(); }
                const osc = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                osc.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                let now = audioCtx.currentTime;
                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(600, now);
                    gainNode.gain.setValueAtTime(0.1, now);
                    osc.start(now); osc.stop(now + 0.05);
                } else if (type === 'win') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    gainNode.gain.setValueAtTime(0.2, now);
                    osc.start(now); osc.stop(now + 0.3);
                }
            } catch(e){}
        }

        const ADMIN_USER = 'ccc2ooo';
        const ADMIN_PASSWORD = 'anooalaa';

        // Full Store List based on App Screenshot
        let defaultStoreItems = [
            { id: 1, name: "100 نقطة", cost: 100, badge: "rare", badgeText: "نادرة", icon: "💯" },
            { id: 2, name: "حساب تيك توك 15k", cost: 1200, badge: "epic", badgeText: "ملحمية", icon: "🎵" },
            { id: 3, name: "250 نقطة", cost: 250, badge: "normal", badgeText: "عادية", icon: "💯" },
            { id: 4, name: "كارت سيارة $200", cost: 1500, badge: "epic", badgeText: "ملحمية", icon: "🚗" },
            { id: 5, name: "جائزة أسطورية", cost: 3000, badge: "legendary", badgeText: "أسطورية", icon: "🏆" },
            { id: 6, name: "حساب ببجي قيمته $150", cost: 2500, badge: "normal", badgeText: "عادية", icon: "🎮" },
            { id: 7, name: "رويال باس", cost: 600, badge: "normal", badgeText: "عادية", icon: "👑" },
            { id: 8, name: "حساب انستا 10k", cost: 1000, badge: "normal", badgeText: "عادية", icon: "📸" },
            { id: 9, name: "رشق تيك توك", cost: 400, badge: "normal", badgeText: "عادية", icon: "⚡" },
            { id: 10, name: "رشق حسابك الانستا", cost: 400, badge: "normal", badgeText: "عادية", icon: "✨" },
            { id: 11, name: "10 نقاط", cost: 10, badge: "normal", badgeText: "عادية", icon: "📦" },
            { id: 12, name: "50 نقطة", cost: 50, badge: "normal", badgeText: "عادية", icon: "📦" },
            { id: 13, name: "500 نقطة", cost: 500, badge: "epic", badgeText: "ملحمية", icon: "💎" },
            { id: 14, name: "حظ أوفر", cost: 0, badge: "normal", badgeText: "عادية", icon: "📦" },
            { id: 15, name: "جائزة خاصة", cost: 2000, badge: "epic", badgeText: "ملحمية", icon: "🔮" }
        ];

        let defaultPrizes = [
            { name: "100 نقطة", icon: "💯", weight: 20 },
            { name: "رويال باس", icon: "👑", weight: 10 },
            { name: "50 نقطة", icon: "📦", weight: 30 },
            { name: "حظ أوفر", icon: "❌", weight: 40 }
        ];

        function getStoreItems() { return defaultStoreItems; }
        function getPrizes() { return defaultPrizes; }

        function showToast(msg) {
            let toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => toast.classList.add('opacity-0', 'pointer-events-none'), 2000);
        }

        function renderStore() {
            let items = getStoreItems();
            let container = document.getElementById('storeItemsContainer');
            if(!container) return;
            container.innerHTML = '';
            
            items.forEach(item => {
                let badgeClass = "badge-normal";
                if(item.badge === "rare") badgeClass = "badge-rare";
                if(item.badge === "epic") badgeClass = "badge-epic";
                if(item.badge === "legendary") badgeClass = "badge-legendary";

                let row = document.createElement('div');
                row.className = "card-dark p-3 flex justify-between items-center card-hover";
                row.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="badge ${badgeClass} text-[9px] px-2 py-0.5 rounded font-bold">${item.badgeText}</span>
                        <span class="font-bold text-xs text-white">${item.name}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-black text-amber-400 text-xs">${item.cost > 0 ? item.cost + ' نقطة' : ''}</span>
                        <div class="w-8 h-8 rounded-lg bg-black/60 border border-gray-800 flex items-center justify-center text-sm">${item.icon}</div>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function switchTab(tabId, btnElement) {
            ['home', 'store', 'creators', 'prizes', 'notifications', 'profile'].forEach(t => {
                let tabEl = document.getElementById('tab-' + t);
                if(tabEl) tabEl.classList.add('hidden');
            });
            let targetTab = document.getElementById('tab-' + tabId);
            if(targetTab) targetTab.classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(b => {
                b.classList.remove('text-amber-400');
                b.classList.add('text-gray-400');
            });
            if(btnElement) {
                btnElement.classList.remove('text-gray-400');
                btnElement.classList.add('text-amber-400');
            }
        }

        function openLoginModal() { document.getElementById('loginModal').classList.remove('hidden'); }
        function closeLoginModal() { document.getElementById('loginModal').classList.add('hidden'); }
        
        function loginUser() {
            let val = document.getElementById('userPhoneOrTg').value.trim();
            if(!val) return;
            localStorage.setItem('mansour_sami_user', val);
            closeLoginModal();
            checkUserState();
            showToast("تم تسجيل الدخول بنجاح! 🚀");
        }

        function logoutUser() {
            localStorage.removeItem('mansour_sami_user');
            checkUserState();
            switchTab('home', document.querySelector('[data-tab="home"]'));
            showToast("تم تسجيل الخروج");
        }

        function checkUserState() {
            let user = localStorage.getItem('mansour_sami_user');
            let adminQuickBox = document.getElementById('adminQuickAccessBox');

            if(user) {
                document.getElementById('loginBtnHeader').innerText = '@' + user;
                document.getElementById('profileNameDisplay').innerText = '@' + user;
                if(user === ADMIN_USER) adminQuickBox.classList.remove('hidden');
            } else {
                document.getElementById('loginBtnHeader').innerText = 'تسجيل الدخول';
                document.getElementById('profileNameDisplay').innerText = 'زائر';
                adminQuickBox.classList.add('hidden');
            }
        }

        function openAdminLogin() { document.getElementById('adminLoginModal').classList.remove('hidden'); }
        function closeAdminLogin() { document.getElementById('adminLoginModal').classList.add('hidden'); }
        function openDirectAdminPanel() { document.getElementById('adminPanelModal').classList.remove('hidden'); }
        
        function verifyAdmin() {
            let pass = document.getElementById('adminPasswordInput').value.trim();
            if(pass === ADMIN_PASSWORD) { closeAdminLogin(); openDirectAdminPanel(); }
            else alert("كلمة المرور غير صحيحة!");
        }
        function closeAdminPanel() { document.getElementById('adminPanelModal').classList.add('hidden'); }

        window.addEventListener('DOMContentLoaded', () => {
            renderStore();
            checkUserState();
        });
    </script>
</body>
</html>
